            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-user-001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"jane.doe@resolve.com\",\n  \"username\": \"jane.doe\",\n  \"fullName\": \"Jane Doe\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users?organizationId={{orgId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users"],
          "query": [
            {
              "key": "organizationId",
              "value": "{{orgId}}"
            }
          ]
        }
      }
